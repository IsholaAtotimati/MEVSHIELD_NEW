# Frontend environment example for MEVShield (Vite)
#
# Every VITE_* value is inlined into the public browser bundle. Never put a
# secret, private key, or API key here.
#
# Chain and contract settings default to the published Sepolia configuration.
# Set VITE_API_URL for any deployed frontend; production has no localhost
# backend fallback.

# Backend base URL, as reached from the browser. Set to the deployed Railway
# public URL in Vercel; localhost is only the development default.
VITE_API_URL=http://localhost:4000

# Local development demo signing. This remains off in hosted production.
VITE_SEPOLIA_DEMO_MODE=false

# Hosted demo: show a deterministic estimate and allow risk previews, but never
# sign policies or execute swaps. Set true only for the public demo deployment.
VITE_READ_ONLY_DEMO_MODE=false

# Opens the normal signing/execution gate. Demo mode is an explicit exception
# for development builds and is not safe for value-bearing trades.
# See docs/decisions/0005-execute-gate-stays-closed.md
VITE_MINIMUM_OUTPUT_V2_DEPLOYMENT_VERIFIED=false

# ---------------------------------------------------------------------------
# Chain selection
# ---------------------------------------------------------------------------
# Chain the client reads and asks the wallet to switch to.
# Default 11155111 (Sepolia). Set to 31337 only for the local Docker stack.
VITE_CHAIN_ID=11155111

# Read RPC endpoint. Default is the public Sepolia RPC.
# Local stack: http://localhost:8545
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional block explorer base URL for address and transaction links.
# Default https://sepolia.etherscan.io on Sepolia, and no explorer locally.
# VITE_EXPLORER_URL=

# ---------------------------------------------------------------------------
# Contract addresses
# ---------------------------------------------------------------------------
# Every one of these defaults to the published Sepolia deployment. Overriding an
# address changes what the UI reads and displays. It does not open the execute
# gate, which stays controlled by VITE_MINIMUM_OUTPUT_V2_DEPLOYMENT_VERIFIED and
# the readiness checks in src/lib/protectedQuote.ts.
#
# The commented values are the Sepolia defaults; docker-compose overrides them
# for the local stack from the deploy output.
#
# VITE_POOL_MANAGER_ADDRESS=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
# VITE_POLICY_REGISTRY_ADDRESS=0x3b1b05954b226633e87cC875593E5E8FB998eFBC
# VITE_POLICY_VERIFIER_ADDRESS=0xD3635b589dB0B4E215283274937C0b7600314A6d
# VITE_POLICY_AUTHORIZATION_ADDRESS=0xEDC98B44349EDF0D0b71cBc5D4523352ffB8c821
# VITE_MEVSHIELD_HOOK_ADDRESS=0x15D8C5eb1b839A4Fd86989348c1371c10168c080
# VITE_MEVSHIELD_ROUTER_ADDRESS=0x78ffC9Fd8cd6312Ac6f4038FBBFF4870d8dC4283
# VITE_AUTHORIZED_SIGNER_ADDRESS=0x016B78a30CE176EF0B90c122e8677e13aAB2A815

# ---------------------------------------------------------------------------
# Pool tokens
# ---------------------------------------------------------------------------
# Sepolia: WETH9 (18 decimals) and test USDC (6 decimals). Both Sepolia
# defaults are compiled in, so a Sepolia build needs no environment at all.
#
# The LOCAL chain (VITE_CHAIN_ID=31337) has NO defaults for these two: the mock
# pair is deployed fresh by script/SetupBackendSwap.s.sol, so a built-in address
# could only be a guess. Omitting them on the local chain is an explicit
# configuration error that the UI reports, not a defaulted value.
# docker-compose.yml supplies both as build args for the local stack.
#
# VITE_TOKEN0_ADDRESS=0xfff9976782d46cc05630d1f6ebab18b2324d6b14
# VITE_TOKEN1_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# VITE_TOKEN0_SYMBOL=WETH
# VITE_TOKEN1_SYMBOL=USDC
