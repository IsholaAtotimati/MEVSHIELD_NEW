# Compiler files
cache/
out/
node_modules/
backend/dist/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/*/11155111/
/broadcast/**/dry-run/

# Local notes stay untracked. Published reviews and the operator runbooks are
# committed.
docs/*
!docs/reviews/
!docs/runbook/

# Dotenv files - ignore all dotenvs but track examples
.env
.env.*
!.env.example
!.env.*.example
