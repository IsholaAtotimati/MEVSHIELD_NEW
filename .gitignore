# Compiler files
cache/
out/
node_modules/
backend/dist/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/*/11155111/
/broadcast/**/dry-run/

# Local notes stay untracked. Published reviews, the maintained doc set, and the
# operator runbooks are committed.
docs/*
!docs/README.md
!docs/architecture/
!docs/services/
!docs/api/
!docs/features/
!docs/operations/
!docs/decisions/
!docs/reviews/
!docs/runbook/

# Dotenv files - ignore all dotenvs but track examples
.env
.env.*
!.env.example
!.env.*.example
