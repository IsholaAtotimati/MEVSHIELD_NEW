# MEVShield local Docker configuration.
#
# Copy this file to docker/.env.docker and edit if needed:
#
#   cp docker/.env.docker.example docker/.env.docker
#
# docker-compose.yml loads docker/.env.docker automatically when it exists.
# Every value below has a working default, so the stack starts without copying.
#
# ---------------------------------------------------------------------------
# WARNING - READ BEFORE EDITING
# ---------------------------------------------------------------------------
# Everything in this file configures a LOCAL anvil chain on chain id 31337.
#
# The private keys here are anvil's published development keys. They are derived
# from the mnemonic "test test test ... junk", they are in every anvil install,
# and anyone can spend from them. They are INSECURE and LOCAL ONLY.
#
# Never put a key with value in this file. Never reuse these keys on Sepolia,
# mainnet, or any network that holds real assets.

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
# Port on your machine, mapped to the container's port. Change these if
# something else already uses 8545, 4000 or 5173.
ANVIL_PORT=8545
BACKEND_PORT=4000
FRONTEND_PORT=5173

# ---------------------------------------------------------------------------
# Contracts deployment
# ---------------------------------------------------------------------------
# Key that deploys the contracts. anvil account #0.
# INSECURE, LOCAL ONLY. Derived from the published anvil test mnemonic.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# LOG_LEVEL controls log verbosity: debug | info | warn | error.
LOG_LEVEL=info

# Policy signing. Enabling this opens POST /policy, which signs EIP-712 policy
# structs with SIGNER_PRIVATE_KEY. It is on here so the local flow exercises
# real signing.
MEVSHIELD_V2_POLICY_ENABLED=true

# Key the backend signs policies with. Must match the signer that
# script/DeployLocal.s.sol installs on the PolicyVerifier, which is the address
# for private key 0xA11CE (0xe05fcC23807536bEe418f142D19fa0d21BB0cfF7).
# INSECURE, LOCAL ONLY. A backend with a different key fails to start.
SIGNER_PRIVATE_KEY=0x00000000000000000000000000000000000000000000000000000000000a11ce

# Allowed CORS origin. Must be exactly the URL your browser uses for the
# frontend, or every API call from the page is blocked. This is the default
# http://localhost:<FRONTEND_PORT>.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (build-time)
# ---------------------------------------------------------------------------
# Vite inlines every VITE_* value into the public JavaScript bundle. None of
# these is a secret.

# Backend URL as reached from the browser, not the compose service name.
VITE_API_URL=http://localhost:4000

# Read RPC endpoint as reached from the browser. If you change ANVIL_PORT, change
# this to match.
VITE_RPC_URL=http://localhost:8545

# The execute gate. Leave this false.
#
# Setting it to true is the single action that enables swap execution in the UI.
# See docs/decisions/0005-execute-gate-stays-closed.md. The local stack does not
# need it open: the quote, policy and readiness checks all run without it.
VITE_MINIMUM_OUTPUT_V2_DEPLOYMENT_VERIFIED=false

# ---------------------------------------------------------------------------
# Not configurable here, by design
# ---------------------------------------------------------------------------
# These are set directly in docker-compose.yml because changing them breaks the
# pinning guarantees:
#
#   CHAIN_ID=31337                          the local chain, checked at startup
#   MEVSHIELD_LOCAL_CHAIN_ENABLED=true      the explicit local gate
#   NODE_ENV=development                    required for that gate to open
#   POLICY_VERIFIER_ADDRESS                 the deployed verifier
#   ROUTER_ADDRESS                          the deployed router
#   PROTECTED_POOL_*                        the deployed pool
#   VITE_*_ADDRESS                          the deployed addresses
#
# The backend pins the exact deployed addresses rather than accepting whatever
# the deploy produced. A mismatch fails startup, which is the intended
# fail-closed behaviour. If you redeploy with different addresses you must update
# both files, and that is deliberate friction.
