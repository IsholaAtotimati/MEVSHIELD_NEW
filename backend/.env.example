# Backend environment example for MEVShield
# Do NOT put secrets here — only placeholders.

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Redis shared TTL store; production requires REDIS_URL. Local development may omit it.
REDIS_URL=redis://localhost:6379

# EIP-712 chain and verifier
CHAIN_ID=11155111
# Keep disabled until pool readiness and the complete production signing path are verified.
MEVSHIELD_V2_POLICY_ENABLED=false
# Set true only after the replacement deployment passes the read-only preflight.
MEVSHIELD_V2_DEPLOYMENT_VERIFIED=false
# Local-only demo override; ignored in production and on Railway.
MEVSHIELD_SEPOLIA_DEMO_ENABLED=false

# Required replacement deployment pins when MEVSHIELD_V2_DEPLOYMENT_VERIFIED=true.
# Keep unset until the deployed contracts and replacement pool pass preflight.
# MEVSHIELD_SEPOLIA_SIGNER_ADDRESS=
# MEVSHIELD_SEPOLIA_VERIFIER_ADDRESS=
# MEVSHIELD_SEPOLIA_ROUTER_ADDRESS=
# MEVSHIELD_SEPOLIA_REGISTRY_ADDRESS=
# MEVSHIELD_SEPOLIA_AUTHORIZATION_ADDRESS=
# MEVSHIELD_SEPOLIA_HOOK_ADDRESS=
# MEVSHIELD_SEPOLIA_POOL_ID=

# Authoritative protected Sepolia WETH/USDC pool configuration.
# This identifies the candidate pool only; it does not mean the pool is initialized or liquid.
PROTECTED_POOL_CURRENCY0=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
PROTECTED_POOL_CURRENCY1=0xfff9976782d46cc05630d1f6ebab18b2324d6b14
PROTECTED_POOL_FEE=3000
PROTECTED_POOL_TICK_SPACING=60
PROTECTED_POOL_HOOK=0x15D8C5eb1b839A4Fd86989348c1371c10168c080
PROTECTED_POOL_ID=0xba95e58e09df6620bcf06cf124eb902eba371655696b14ba8b43ec1b9fc22235

# Sepolia event monitor. If unset, the monitor also accepts the existing
# RPC_URL name. Never put provider API keys in the frontend.
SEPOLIA_RPC_URL=https://your-sepolia-rpc-url
POLICY_REGISTRY_ADDRESS=0x3b1b05954b226633e87cC875593E5E8FB998eFBC
POLICY_REGISTRY=0x3b1b05954b226633e87cC875593E5E8FB998eFBC
POLICY_VERIFIER_ADDRESS=0xD3635b589dB0B4E215283274937C0b7600314A6d
POLICY_VERIFIER=0xD3635b589dB0B4E215283274937C0b7600314A6d
POLICY_AUTHORIZATION_ADDRESS=0xEDC98B44349EDF0D0b71cBc5D4523352ffB8c821
HOOK_ADDRESS=0x15D8C5eb1b839A4Fd86989348c1371c10168c080
MEVSHIELD_HOOK_ADDRESS=0x15D8C5eb1b839A4Fd86989348c1371c10168c080
ROUTER_ADDRESS=0x78ffC9Fd8cd6312Ac6f4038FBBFF4870d8dC4283
MEVSHIELD_ROUTER=0x78ffC9Fd8cd6312Ac6f4038FBBFF4870d8dC4283

# Private keys (never commit real keys)
SIGNER_PRIVATE_KEY=0xYOUR_SIGNER_PRIVATE_KEY

# On-chain addresses
VERIFIER_ADDRESS=0xD3635b589dB0B4E215283274937C0b7600314A6d

# Frontend URL (used by CORS)
FRONTEND_URL=http://localhost:5173
