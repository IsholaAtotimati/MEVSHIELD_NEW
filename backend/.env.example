# Backend environment example for MEVShield
# Do NOT put secrets here — only placeholders.

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# EIP-712 chain and verifier
CHAIN_ID=11155111

# Sepolia event monitor. If unset, the monitor also accepts the existing
# RPC_URL name. Never put provider API keys in the frontend.
SEPOLIA_RPC_URL=https://your-sepolia-rpc-url
POLICY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
POLICY_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
POLICY_AUTHORIZATION_ADDRESS=0x0000000000000000000000000000000000000000
HOOK_ADDRESS=0x0000000000000000000000000000000000000000
ROUTER_ADDRESS=0x0000000000000000000000000000000000000000

# Private keys (never commit real keys)
SIGNER_PRIVATE_KEY=0xYOUR_SIGNER_PRIVATE_KEY

# On-chain addresses
VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
MEVSHIELD_ROUTER=0x0000000000000000000000000000000000000000

# Frontend URL (used by CORS)
FRONTEND_URL=http://localhost:5173
