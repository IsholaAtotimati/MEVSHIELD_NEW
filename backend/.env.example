# Backend environment example for MEVShield
# Do NOT put secrets here — only placeholders.

# Server
PORT=4000

# EIP-712 chain and verifier
CHAIN_ID=11155111

# Private keys (never commit real keys)
SIGNER_PRIVATE_KEY=0xYOUR_SIGNER_PRIVATE_KEY

# On-chain addresses
VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
MEVSHIELD_ROUTER=0x0000000000000000000000000000000000000000

# Frontend URL (used by CORS)
FRONTEND_URL=http://localhost:5173
